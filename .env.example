# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实凭据。

# ---- 运行模式 ----
# 本地 HTTP 试运行：default + false；生产 HTTPS：prod（会强制 Secure Cookie）
SPRING_PROFILES_ACTIVE=default
SESSION_COOKIE_SECURE=false
# 本地用 nginx-http.conf；生产 HTTPS 用 nginx-https.conf
NGINX_CONF=nginx-http.conf
HTTP_PORT=80
HTTPS_PORT=443

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# ---- 管理员一次性初始化（仅当数据库中没有管理员时生效，创建后请删除密码行并重启）----
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=

# ---- 站点 ----
BLOG_SITE_TITLE=我的技术博客
BLOG_SITE_DESCRIPTION=记录 Java 后端学习、研究笔记与个人项目
BLOG_SITE_BASE_URL=http://localhost

# ---- 阿里云 OSS（不填时站点可运行，但文件功能不可用）----
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_PUBLIC_BUCKET=
OSS_PRIVATE_BUCKET=
# 可选：CDN 私有回源固定域名，例如 https://static.example.com
OSS_PUBLIC_BASE_URL=
# 部署在 ECS 时优先使用 RAM 角色，填写角色名后无需 AccessKey
OSS_ECS_RAM_ROLE=
# 否则使用最小权限 RAM 用户的 AccessKey（或 STS 临时凭据）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
